{
  "name": "astroidal",
  "version": "0.1.0",
  "description": "AI code review map, scorer, and helper. Draws the blast radius, hands an agent a bug map, and scores what survives. Run with npx, without adding a dependency.",
  "type": "module",
  "bin": {
    "astroidal": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "ai-code-review",
    "code-review",
    "code-review-tool",
    "bug-map",
    "ast",
    "cli",
    "pull-request",
    "static-analysis"
  ],
  "license": "MIT",
  "author": "Mgs. M. Rizqi Fadhlurrahman <rizqirizqi23@gmail.com>",
  "homepage": "https://astroidal.webstor.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rizqirizqi/astroidal.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/rizqirizqi/astroidal/issues"
  },
  "scripts": {
    "build": "tsc && cp src/sky-script.js dist/sky-script.js",
    "test": "npm run build && node --test dist/*.test.js",
    "prepack": "npm run build && rm -f dist/*.test.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@astroidal/eslint-config": "*",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3"
  }
}
