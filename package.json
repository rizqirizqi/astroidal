{
  "name": "astroidal-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w astroidal",
    "test": "npm run test -w astroidal",
    "dev:site": "npm run dev -w astroidal-site",
    "lint": "npm run lint --workspaces --if-present && prettier --check .",
    "lint:fix": "npm run lint:fix --workspaces --if-present && prettier --write .",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,json,css,md}\"",
    "check-types": "npm run check-types --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.0",
  "lint-staged": {
    "packages/cli/**/*.{js,mjs,ts}": [
      "eslint --fix --max-warnings 0 -c packages/cli/eslint.config.mjs",
      "prettier --write"
    ],
    "apps/site/**/*.{js,mjs,ts,tsx}": [
      "eslint --fix --max-warnings 0 -c apps/site/eslint.config.mjs",
      "prettier --write"
    ],
    "**/*.{json,css,md}": "prettier --write"
  }
}
